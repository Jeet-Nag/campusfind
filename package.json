{
  "name": "chandil-home-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hyperlocal home-services platform for Chandil, Jharkhand",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build:client:web": "npm --workspace=client run build:web",
    "build:android:staging": "npm --workspace=client run build:android:staging",
    "build:android:production": "npm --workspace=client run build:android:production",
    "test": "npm --workspace=server run test",
    "test:static": "npm --workspace=server run test:static",
    "test:hardening": "npm --workspace=server run test:hardening",
    "db:migrate": "npm --workspace=server run db:migrate",
    "db:verify": "npm --workspace=server run db:verify",
    "capacitor:copy:after": "node scripts/clean-android-assets.js",
    "cap:sync": "npx cap sync android && node scripts/clean-android-assets.js"
  },
  "keywords": [
    "chandil",
    "home-services",
    "fastify",
    "preact"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2"
  }
}
