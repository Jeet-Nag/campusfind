# CampusFind — Application Configuration

# Server Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Local example: postgresql://postgres:postgres@localhost:5432/campusfind_db
# Cloud example (Neon/Supabase/RDS): postgresql://[user]:[password]@[host]:5432/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusfind_db
DATABASE_SSL=false

# Authentication & Security
# Min 32 character strong secret key for JWT session tokens
JWT_SECRET=campusfind-super-secret-jwt-key-min-32-chars-long!

# CORS Origins (comma-separated for production deployments)
# CORS_ORIGIN=https://campusfind.university.edu

# Local File Storage
UPLOAD_DIR=./uploads

# WebAuthn / Passkeys (Optional fallback configuration)
RP_ID=localhost
RP_NAME=CampusFind University Portal
EXPECTED_ORIGIN=http://localhost:3000
